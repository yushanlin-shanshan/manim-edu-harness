# Zhipu (智谱) Open Platform — chat/planner still uses this
# Copy to .env and fill in. Never commit .env.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus

# TTS provider: volcengine (default) | zhipu
TTS_PROVIDER=volcengine

# Volcengine 豆包语音合成 2.0 — https://docs.volcengine.com/docs/6561/1598757
# Get APP ID / Access Token from console (never commit real values)
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_SECRET_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=zh_male_m191_uranus_bigtts
# VOLC_TTS_FORMAT=mp3
# VOLC_TTS_SAMPLE_RATE=24000
# VOLC_TTS_SPEED=1.0
# VOLC_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional

# Optional Zhipu TTS fallback (TTS_PROVIDER=zhipu)
# ZHIPU_TTS_MODEL=glm-tts
# ZHIPU_TTS_VOICE=tongtong
# ZHIPU_TTS_SPEED=1.0

# Optional overrides
# HARNESS_LANG=zh-CN
# MANIM_QUALITY=l
# MANIM_REQUIRE_RENDER=0
